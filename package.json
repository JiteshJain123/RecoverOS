{
  "name": "recoveros",
  "version": "0.0.0",
  "private": true,
  "description": "RecoverOS — AI Revenue Recovery Operating System: detects revenue at risk and safely recovers it (Razorpay Test Mode).",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev:api": "pnpm --filter @recoveros/api dev",
    "dev:web": "pnpm --filter @recoveros/web dev",
    "build": "pnpm typecheck && pnpm --filter @recoveros/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"packages/**/src/**/*.test.ts\" \"apps/**/src/**/*.test.ts\"",
    "intel:scan": "tsx scripts/intelligence-scan.ts",
    "intel:batch": "tsx scripts/intelligence-batch.ts",
    "recovery:batch": "tsx scripts/recovery-batch-eval.ts",
    "recovery:lifecycle": "tsx scripts/recovery-lifecycle-batch.ts",
    "verify:integrations": "tsx scripts/verify-integrations.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@prisma/client": "^6.2.1",
    "@recoveros/database": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
