# RecoverOS environment variables (PLACEHOLDERS ONLY — never commit real secrets)
# Copy this file to `.env` and fill in real values locally.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
WEB_PORT=3000

# Database (PostgreSQL) — used by the database/prisma package
DATABASE_URL=postgresql://recoveros:recoveros@localhost:5432/recoveros?schema=public

# Google Gemini (AI package). The advisory recovery-strategy provider.
# GEMINI_MODEL drives the model everywhere (never hardcoded). Leave the key
# blank to disable Gemini recommendations (the dev endpoint returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Razorpay TEST MODE ONLY (payments package). Key id MUST be rzp_test_*;
# a rzp_live_* key is rejected. Secrets are never stored in Postgres, logged,
# or returned by any endpoint. Leave blank to disable (verify endpoint → 503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signature secret + Test Mode account→tenant mapping. A webhook is
# trusted only if its provider account_id equals RAZORPAY_WEBHOOK_ACCOUNT_ID; it
# is then mapped to RAZORPAY_WEBHOOK_TENANT_ID. Unmapped accounts are rejected.
RAZORPAY_WEBHOOK_ACCOUNT_ID=
RAZORPAY_WEBHOOK_TENANT_ID=
RAZORPAY_WEBHOOK_SECRET=
